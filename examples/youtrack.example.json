        {"name": "Type", "field_type": "enum[1]", "bundle": "Types", "projects": ["DEMO"], "can_be_empty": false},
        {"name": "State", "field_type": "state[1]", "bundle": "States", "projects": ["DEMO"]},
        {"name": "Due Date", "field_type": "date", "projects": ["DEMO"]}
      ]
    },
    "link_types": {
